# Copie este arquivo para ".env" e preencha com os valores reais.
# NUNCA suba o arquivo ".env" (com os valores de verdade) para o GitHub ou qualquer lugar público.

# Uma frase secreta qualquer, só pra clínica, usada para assinar as sessões de login.
JWT_SECRET=troque-por-um-segredo-bem-grande-e-aleatorio

# Credenciais do Supabase (Project Settings → API, no painel do seu projeto)
SUPABASE_URL=
SUPABASE_KEY=

# Porta em que o servidor vai rodar (a maioria dos hosts define isso automaticamente)
PORT=3000
